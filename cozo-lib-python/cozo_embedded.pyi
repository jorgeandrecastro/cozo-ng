from typing import Any, Callable, Dict, List, Optional, Set, TypedDict

class NamedRows(TypedDict):
    headers: List[str]
    rows: List[List[Any]]
    next: Optional["NamedRows"]

Params = Dict[str, Any]

class CozoDbMulTx:
    def abort(self) -> None: ...
    def commit(self) -> None: ...
    def run_script(self, query: str, params: Params) -> NamedRows: ...

class CozoDbPy:
    def __init__(self, engine: str, path: str, options: str) -> None: ...
    def run_script(self, query: str, params: Params, immutable: bool) -> NamedRows: ...
    def register_callback(
        self,
        rel: str,
        callback: Callable[[str, List[List[Any]], List[List[Any]]], None],
    ) -> int: ...
    def unregister_callback(self, id: int) -> bool: ...
    def register_fixed_rule(
        self,
        name: str,
        arity: int,
        callback: Callable[[List[List[List[Any]]], Dict[str, Any]], List[List[Any]]],
    ) -> None: ...
    def unregister_fixed_rule(self, name: str) -> bool: ...
    def export_relations(self, relations: List[str]) -> Dict[str, NamedRows]: ...
    def import_relations(self, data: Dict[str, NamedRows]) -> None: ...
    def backup(self, path: str) -> None: ...
    def restore(self, path: str) -> None: ...
    def import_from_backup(self, in_file: str, relations: List[str]) -> None: ...
    def multi_transact(self, write: bool) -> CozoDbMulTx: ...
    def close(self) -> bool: ...

def eval_expressions(query: str, params: Params, bindings: Params) -> Any: ...
def variables(query: str, params: Params) -> Set[str]: ...
